<resources>
  <string name="ExtensionRoleBerserker">Berserker</string>
  <string name="ExtensionRoleBerserkerIntroBlurb">Zabijaj, skracaj cooldown i zostan War.</string>
  <string name="ExtensionRoleBerserkerTabDescription">Zabijaj graczy, aby skracac cooldown. Zbierz dosc zabojstw, aby zostac &lt;color=#EEEEEE&gt;War&lt;/color&gt;.</string>
  <string name="ExtensionRoleBerserkerWikiDescription">&lt;color=#B81020&gt;Berserker&lt;/color&gt; to rola &lt;b&gt;Neutral Apocalypse&lt;/b&gt;. Kazde zabojstwo skraca cooldown zabijania, dopoki nie zbierzesz dosc zabojstw, aby zostac &lt;color=#EEEEEE&gt;War&lt;/color&gt;. Jesli Apokalipsa wygrywa razem, role Apokalipsy sa sojusznikami.</string>
  <string name="ExtensionRoleBerserkerKillsTab">Zabojstwa do War</string>
  <string name="ExtensionRoleBerserkerWarAnnouncement">Wojna pochlonela pole bitwy.\%nl\%\%color=#EEEEEEFF\%War\%/color\%, Jezdziec Apokalipsy, przybyl!</string>

  <string name="ExtensionRoleWar">War</string>
  <string name="ExtensionRoleWarIntroBlurb">Przedrzyj sie przez pole bitwy.</string>
  <string name="ExtensionRoleWarTabDescription">Zabijaj szybko podczas okna furii. War jest niesmiertelny i moze zginac tylko przez wyrzucenie.</string>
  <string name="ExtensionRoleWarWikiDescription">&lt;color=#EEEEEE&gt;War&lt;/color&gt; to przemieniony Berserker. War jest odporny na ataki i wrogie umiejetnosci, moze laczyc zabojstwa w krotkim oknie furii i moze zginac tylko przez glosowanie.</string>

